function syncUrl(){try{const p=new URLSearchParams();p.set('workspace',S.role);p.set('lang',S.lang);if(S.active)p.set('worker',S.active);history.replaceState(null,'',`${location.pathname}?${p}`)}catch{}}
function applyUrl(){try{const p=new URLSearchParams(location.search),r=p.get('workspace')||p.get('role'),l=p.get('lang'),w=p.get('worker');if(['mine','employer','worker'].includes(r)){S.role=r;S.page=r==='worker'?'home':'today'}if(['en','es'].includes(l))S.lang=l;if(w&&W(w))S.active=w}catch{}}
function openWorker(id){if(!W(id))return;S.active=id;S.role='mine';S.page='gate';persist()}
function assign(){const worker=$('#assignWorker')?.value,course=$('#assignCourse')?.value,due=$('#assignDue')?.value,choice=$('#assignLang')?.value;if(!W(worker)||!courses[course]||courses[course].owner!==S.role||!due)return;const lang=choice==='preferred'?(S.preferred[worker]||'en'):choice;S.assignments.push({id:`A-${Date.now()}`,worker,course,due,lang,progress:0,step:0,done:false,awaiting:false,certified:false});modal.hidden=true;persist(t('workerNotified'))}
function submitCourse(){const a=S.assignments.find(x=>x.id===S.courseId);if(!a)return;const correct=[0,1,2].every(i=>$(`input[name="q${i}"]:checked`)?.value==='ok'),ack=$('#ack')?.checked,signature=clean($('#signature')?.value,100);if(!correct||!ack||signature.length<2){toast(t('failed'));return}a.done=true;a.progress=100;a.awaiting=true;a.certified=false;a.completedAt=new Date().toISOString();a.signature=signature;const w=W(a.worker);if(w){w.approved=false;w.approvalKey='';w.checked=false}S.page='home';persist(t('completionReview'))}
function certify(id){const a=S.assignments.find(x=>x.id===id);if(!a||!a.awaiting||courses[a.course]?.owner!==S.role)return;const w=W(a.worker);if(!w)return;if(a.course==='site'){w.orientation=true;w.notice=S.noticeVersion}else if(a.course==='annual')w.refresher=true;else if(a.course==='loader')w.task=true;a.awaiting=false;a.certified=true;a.certifiedAt=new Date().toISOString();a.certifiedBy=S.role==='mine'?'Mine Safety Demo':'Employer Admin Demo';w.approved=false;w.approvalKey='';w.checked=false;persist(t('trainingCertified'))}
function approve(w){if(S.role!=='mine'){toast(t('onlyMine'));return}if(!w||w.hold||!w.identity||!w.refresher||!w.task||!w.orientation||w.notice!==S.noticeVersion){toast(t('notReady'));return}w.approved=true;w.approvalKey=approvalKey(w);w.approvedAt=new Date().toISOString();persist(t('accessApproved'))}
function exportCsv(){const cell=v=>{let x=String(v??'');if(/^\s*[=+\-@]/.test(x))x="'"+x;return `"${x.replaceAll('"','""')}"`};const rows=[['worker_id','name','employer','role','work_order','crew','status','checked_in'],...S.workers.map(w=>[w.id,w.name,w.employer,w.role,w.workOrder,w.crew,status(w),w.checked?'yes':'no'])];const blob=new Blob(['\ufeff'+rows.map(r=>r.map(cell).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`mineready-workforce-${new Date().toISOString().slice(0,10)}.csv`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),0)}
function csvRows(text){const out=[];let row=[],field='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];if(quoted){if(c==='"'&&n==='"'){field+='"';i++}else if(c==='"')quoted=false;else field+=c}else if(c==='"')quoted=true;else if(c===','){row.push(field);field=''}else if(c==='\n'){row.push(field.replace(/\r$/,''));out.push(row);row=[];field=''}else field+=c}if(field||row.length){row.push(field.replace(/\r$/,''));out.push(row)}return out.filter(r=>r.some(v=>v.trim()))}
async function importCsv(file){if(!file)return;if(file.size>1024*1024){toast(t('csvLimit'));return}const rows=csvRows((await file.text()).replace(/^\ufeff/,''));if(rows.length<2){toast(t('csvInvalid'));return}if(rows.length-1>500){toast(t('csvLimit'));return}const heads=rows.shift().map(h=>clean(h,50).toLowerCase().replace(/\s+/g,'_')),find=(...names)=>heads.findIndex(h=>names.includes(h)),ix={id:find('worker_id','id','id_trabajador','identificador'),name:find('name','nombre'),employer:find('employer','empresa','empleador'),role:find('role','puesto','cargo'),work:find('work_order','orden_de_trabajo'),crew:find('crew','cuadrilla','equipo')};if(ix.id<0||ix.name<0){toast(t('csvInvalid'));return}let count=0;for(const r of rows){const v=(k,n)=>ix[k]>=0?clean(r[ix[k]],n):'',id=v('id',40),name=v('name',100);if(!/^[A-Za-z0-9_-]{2,40}$/.test(id)||!name||W(id))continue;const palette=['#91ed27','#79bdff','#ffc65b','#c4a7ff','#4ee08b'];S.workers.push({id,name,initials:name.split(/\s+/).map(x=>x[0]).slice(0,2).join('').toUpperCase(),color:palette[S.workers.length%palette.length],employer:v('employer',100)||'Imported Contractor',role:v('role',80)||'Worker',crew:v('crew',60)||'Unassigned',workOrder:v('work',60)||'Pending',identity:false,refresher:false,task:false,orientation:false,notice:0,approved:false,approvalKey:'',hold:false,checked:false});S.preferred[id]=S.lang;count++}persist(`${count} ${t('csvImported')}`)}
document.addEventListener('click',ev=>{const b=ev.target.closest('button');if(!b)return;if(b.dataset.lang){S.lang=b.dataset.lang;persist();return}if(b.dataset.role){S.role=b.dataset.role;S.page=S.role==='worker'?'home':'today';persist();return}if(b.dataset.page){S.page=b.dataset.page;persist();return}if(b.dataset.openWorker){openWorker(b.dataset.openWorker);return}if(b.dataset.assignWorker!==undefined){assignModal(b.dataset.assignWorker);return}if(b.dataset.start){const a=S.assignments.find(x=>x.id===b.dataset.start);if(a){S.active=a.worker;S.courseId=a.id;S.role='worker';S.lang=a.lang||S.lang;S.page='course';a.progress=Math.max(a.progress||0,10);persist()}return}const a=b.dataset.action,id=b.dataset.id,w=id?W(id):null;if(a==='close'){modal.hidden=true;return}if(a==='assign'){assignModal();return}if(a==='saveAssignment'){assign();return}if(a==='approve'){approve(w);return}if(a==='checkin'){if(S.role!=='mine'||status(w)!=='ready'){toast(t('notReadyCheckin'));return}w.checked=true;w.checkedAt=new Date().toISOString();persist(t('workerCheckedIn'));return}if(a==='checkout'){w.checked=false;persist(t('workerCheckedOut'));return}if(a==='hold'){w.hold=true;w.approved=false;w.approvalKey='';w.checked=false;persist();return}if(a==='unhold'){w.hold=false;persist();return}if(a==='certify'){certify(b.dataset.assignment);return}if(a==='import'){$('#csv')?.click();return}if(a==='export'){exportCsv();return}if(a==='reset'){localStorage.removeItem(K);S=seed();persist();return}if(a==='courseNext'){const x=S.assignments.find(x=>x.id===S.courseId);if(x){x.step=Math.min(3,(x.step||0)+1);x.progress=Math.min(80,x.step*25);persist()}return}if(a==='courseBack'){const x=S.assignments.find(x=>x.id===S.courseId);if(x&&x.step>0){x.step--;persist()}else{S.page='training';persist()}return}if(a==='submitCourse'){submitCourse();return}},true);
document.addEventListener('change',ev=>{if(ev.target.id==='workspace'){S.role=ev.target.value;S.page=S.role==='worker'?'home':'today';persist()}else if(ev.target.id==='gateWorker')openWorker(ev.target.value);else if(ev.target.id==='workerProfile'){S.active=ev.target.value;persist()}else if(ev.target.id==='csv'){const f=ev.target.files?.[0];ev.target.value='';importCsv(f).catch(()=>toast(t('csvInvalid')))}},true);
document.addEventListener('input',ev=>{if(ev.target.id==='search'){const q=ev.target.value.toLowerCase();document.querySelectorAll('[data-worker-row]').forEach(n=>n.hidden=!n.textContent.toLowerCase().includes(q))}});
modal.addEventListener('click',ev=>{if(ev.target===modal)modal.hidden=true});window.addEventListener('keydown',ev=>{if(ev.key==='Escape')modal.hidden=true});
function fatal(err){console.error(err);app.innerHTML=`<main class="boot"><div><div class="logo">09</div><h1>MineReady could not start</h1><p>${e(err?.message||err||'Application error')}</p><button id="fatalReset" class="btn primary">Reset demo and reload</button></div></main>`;$('#fatalReset')?.addEventListener('click',async()=>{try{localStorage.removeItem(K);if('caches'in window){for(const n of await caches.keys())if(n.startsWith('mineready-'))await caches.delete(n)}for(const r of await navigator.serviceWorker?.getRegistrations?.()||[])await r.unregister()}catch{}location.replace('/?reset='+Date.now())})}
window.addEventListener('error',ev=>fatal(ev.error||ev.message));window.addEventListener('unhandledrejection',ev=>fatal(ev.reason));
(async()=>{try{if('serviceWorker'in navigator){for(const r of await navigator.serviceWorker.getRegistrations())await r.unregister()}if('caches'in window){for(const n of await caches.keys())if(n.startsWith('mineready-'))await caches.delete(n)}}catch{}})();
try{applyUrl();S.workers.forEach(w=>{if(w.approved&&!w.approvalKey)w.approvalKey=approvalKey(w);if(w.checked&&status(w)!=='ready')w.checked=false});save();render()}catch(err){fatal(err)}
})();
</script>
