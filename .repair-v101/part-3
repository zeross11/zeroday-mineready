const pages=()=>S.role==='mine'?[['today','today'],['gate','gate'],['people','people'],['training','training']]:S.role==='employer'?[['today','today'],['people','people'],['training','training'],['reports','reports']]:[['home','home'],['training','training'],['pass','pass'],['profile','profile']];
const icons={today:'▦',gate:'⌁',people:'●',training:'▶',reports:'≡',home:'⌂',pass:'▦',profile:'⚙'};
function header(){return `<header class="top"><div class="brand"><div class="logo">09</div><div><strong>MineReady</strong><small>${t('site')}</small></div></div><div class="spacer"></div><select id="workspace" class="workspace" aria-label="Workspace"><option value="mine" ${S.role==='mine'?'selected':''}>${t('mine')}</option><option value="employer" ${S.role==='employer'?'selected':''}>${t('employer')}</option><option value="worker" ${S.role==='worker'?'selected':''}>${t('worker')}</option></select><div class="seg"><button data-lang="en" class="${S.lang==='en'?'active':''}">EN</button><button data-lang="es" class="${S.lang==='es'?'active':''}">ES</button></div><div class="seg demo"><button data-role="mine" class="${S.role==='mine'?'active':''}">${t('mine')}</button><button data-role="employer" class="${S.role==='employer'?'active':''}">${t('employer')}</button><button data-role="worker" class="${S.role==='worker'?'active':''}">${t('worker')}</button></div></header>`}
function nav(){const p=pages();const buttons=p.map(([id,key])=>`<button data-page="${id}" class="${S.page===id?'active':''}">${icons[id]||'•'} <span>${t(key)}</span></button>`).join('');return `<nav class="desktop-nav">${buttons}</nav><nav class="bottom">${buttons}</nav>`}
function reviewsPanel(){const list=S.assignments.filter(a=>a.awaiting&&courses[a.course]?.owner===S.role);if(!list.length)return'';return `<section class="card" style="margin-top:16px"><div class="section" style="margin:0"><div><h2>${t('reviews')}</h2><p>${list.length} · ${t('reviewsHint')}</p></div><button class="btn" data-page="training">${t('training')}</button></div></section>`}
function mineToday(){const bad=S.workers.filter(w=>status(w)!=='ready');return `${hero(t('today'),t('exceptionsHint'))}${stats()}<div class="grid two"><section><div class="section"><div><h2>${t('exceptions')}</h2><p>${bad.length?bad.length+' '+t('actionRequired'):t('noIssues')}</p></div><button class="btn primary small" data-page="gate">${t('openGate')}</button></div><div class="worker-list">${bad.map(w=>row(w,`<br><button class="btn small" data-open-worker="${e(w.id)}">${t('openGate')}</button>`)).join('')||`<div class="card empty">${t('noIssues')}</div>`}</div></section><aside><div class="section"><h2>${t('currentNotice')}</h2></div><div class="card notice"><strong>${t('currentNotice')}</strong><p>${t('noticeBody')}</p></div><div class="section"><h2>${t('onSite')}</h2></div><div class="worker-list">${S.workers.filter(w=>w.checked).map(w=>row(w)).join('')||`<div class="card empty">0 ${t('onSite')}</div>`}</div></aside></div>${reviewsPanel()}`}
function checkList(w){return [['identity',w.identity],['refresher',w.refresher],['task',w.task],['orientation',w.orientation],['notice',w.notice===S.noticeVersion],['approval',w.approved&&w.approvalKey===approvalKey(w)]].map(([k,ok])=>`<div class="check ${ok?'':'bad'}"><i>${ok?'✓':'!'}</i><span>${t(k)}</span></div>`).join('')}
function gate(){const w=W(S.active)||S.workers[0],ok=status(w)==='ready',b=blocker(w);return `${hero(t('gate'),t('validAssignment'))}<div class="grid two"><section class="card"><label class="label">${t('lookup')}<select id="gateWorker" class="select">${S.workers.map(x=>`<option value="${e(x.id)}" ${x.id===w.id?'selected':''}>${e(x.name)} · ${e(x.id)}</option>`).join('')}</select></label><div class="gate">${avatar(w)}<h2>${e(w.name)}</h2><div class="meta">${e(w.employer)} · ${e(w.workOrder)} · ${e(w.role)}</div><div class="big" style="color:${ok?'var(--green)':'var(--amber)'}">${ok?t('approved'):t('actionRequired')}</div><p class="meta">${b?t(b):t('validAssignment')}</p>${b?`<p class="owner">${t(ownerOf(w))}</p>`:''}<div class="checks">${checkList(w)}</div><div class="actions">${!w.approved&&!w.hold?`<button class="btn primary" data-action="approve" data-id="${e(w.id)}">${t('approve')}</button>`:''}${ok?`<button class="btn primary" data-action="${w.checked?'checkout':'checkin'}" data-id="${e(w.id)}">${t(w.checked?'checkOut':'checkIn')}</button>`:''}<button class="btn ${w.hold?'':'danger'}" data-action="${w.hold?'unhold':'hold'}" data-id="${e(w.id)}">${t(w.hold?'removeHold':'placeHold')}</button></div></div></section><aside><div class="section"><h2>${t('expected')}</h2></div><div class="worker-list">${S.workers.map(x=>row(x,`<br><button class="btn small" data-open-worker="${e(x.id)}">${t('gate')}</button>`)).join('')}</div></aside></div>`}
function people(){return `${hero(t('people'),t('expected'))}<div class="toolbar"><input id="search" class="input search" placeholder="${t('search')}" autocomplete="off"><button class="btn" data-action="import">${t('import')}</button><button class="btn" data-action="export">${t('export')}</button><input id="csv" type="file" accept=".csv,text/csv" hidden></div><div class="section"><h2>${t('people')}</h2></div><div id="peopleList" class="worker-list tiles">${S.workers.map(w=>row(w,S.role==='employer'?`<br><button class="btn small" data-assign-worker="${e(w.id)}">${t('assign')}</button>`:'' )).join('')}</div>`}
function assignmentState(a){return a.certified?'certified':a.awaiting?(courses[a.course].owner==='mine'?'awaitingMine':'awaitingEmployer'):a.done?'completed':a.progress?'inProgress':'assigned'}
function assignmentCard(a){const w=W(a.worker),c=courses[a.course],state=assignmentState(a),pct=a.certified||a.done?100:(a.progress||0);const canReview=a.awaiting&&c.owner===S.role;return `<article class="card course"><div><span class="status ${a.certified?'ready':a.awaiting||a.progress?'pending':'blocked'}">${t(state)}</span> <span class="owner">${t(c.owner==='mine'?'mineOwned':'employerOwned')}</span></div><h3>${t(c.title)}</h3><div class="meta">${e(w?.name||a.worker)} · ${t('due')}: ${e(a.due)} · ${a.lang==='es'?t('spanish'):t('english')}</div><div class="progress"><i style="width:${pct}%"></i></div>${S.role==='worker'&&!a.done?`<button class="btn primary" data-start="${e(a.id)}">${t(a.progress?'continue':'start')}</button>`:''}${canReview?`<button class="btn primary" data-action="certify" data-assignment="${e(a.id)}">${t('reviewCertify')}</button>`:''}</article>`}
function training(){const list=S.role==='worker'?S.assignments.filter(a=>a.worker===S.active):S.assignments.filter(a=>courses[a.course]?.owner===S.role);return `${hero(t('training'),S.role==='worker'?t('myTraining'):t('reviewsHint'))}${S.role!=='worker'?`<button class="btn primary" data-action="assign">${t('assignTraining')}</button>`:''}<div class="section"><h2>${t('training')}</h2></div><div class="grid three">${list.map(assignmentCard).join('')||`<div class="card empty">${t('noAssignments')}</div>`}</div>`}
function employerToday(){const mine=S.workers.filter(w=>['identityMissing','expired','taskMissing'].includes(blocker(w)));const pending=S.assignments.filter(a=>courses[a.course]?.owner==='employer'&&!a.certified);return `${hero(t('today'),t('employerAction'))}${stats()}<div class="section"><div><h2>${t('exceptions')}</h2><p>${mine.length} ${t('employerAction')}</p></div><button class="btn primary small" data-action="assign">${t('assign')}</button></div><div class="worker-list tiles">${mine.map(w=>row(w,`<br><button class="btn small" data-assign-worker="${e(w.id)}">${t('assign')}</button>`)).join('')||`<div class="card empty">${t('noIssues')}</div>`}</div><div class="section"><h2>${t('training')}</h2></div><div class="grid three">${pending.map(assignmentCard).join('')||`<div class="card empty">${t('noAssignments')}</div>`}</div>${reviewsPanel()}`}
function reports(){return `${hero(t('reports'),t('status'))}<div class="grid stats"><div class="card stat"><b>${S.assignments.length}</b><span>${t('assigned')}</span></div><div class="card stat"><b>${S.assignments.filter(a=>a.done).length}</b><span>${t('completed')}</span></div><div class="card stat"><b>${S.assignments.filter(a=>a.certified).length}</b><span>${t('certified')}</span></div><div class="card stat"><b>${S.workers.filter(w=>w.checked).length}</b><span>${t('onSite')}</span></div></div><div class="section"><h2>${t('reports')}</h2></div><div class="actions"><button class="btn" data-action="export">${t('export')}</button><button class="btn danger" data-action="reset">${t('reset')}</button></div>`}
function workerHome(){const w=W(S.active)||S.workers[0],list=S.assignments.filter(a=>a.worker===w.id);return `${hero(t('home'),t('showGate'))}<div class="grid two"><section class="card pass">${avatar(w)}<h2>${e(w.name)}</h2><p class="meta">${e(w.employer)} · ${e(w.role)}</p><div class="big" style="color:${status(w)==='ready'?'var(--green)':'var(--amber)'}">${status(w)==='ready'?t('approved'):t('actionRequired')}</div><p>${blocker(w)?t(blocker(w)):t('validAssignment')}</p><button class="btn primary" data-page="pass">${t('workerPass')}</button></section><section><div class="section"><h2>${t('myTraining')}</h2></div><div class="grid">${list.map(assignmentCard).join('')||`<div class="card empty">${t('noAssignments')}</div>`}</div></section></div>`}
function qr(id){let n=[...id].reduce((a,c)=>((a*31+c.charCodeAt(0))|0),17),out='';for(let i=0;i<441;i++){n=(n*1664525+1013904223)|0;const finder=(i<63&&i%21<7)||(i<147&&i>=126&&i%21<7)||(i<21&&i%21>13);out+=`<b class="${finder||((n>>>28)&1)?'on':''}"></b>`}return out}
function passPage(){const w=W(S.active)||S.workers[0];return `${hero(t('workerPass'),t('showGate'))}<section class="card pass" style="max-width:480px;margin:auto">${avatar(w)}<h2>${e(w.name)}</h2><div class="meta">${e(w.employer)}<br>${t('workOrder')}: ${e(w.workOrder)} · ${e(w.crew)}</div><div class="big" style="color:${status(w)==='ready'?'var(--green)':'var(--amber)'}">${status(w)==='ready'?t('approved'):t('actionRequired')}</div><div class="qr" aria-label="Worker credential">${qr(w.id)}</div><strong>${e(w.id)}</strong><p class="meta">${blocker(w)?t(blocker(w)):t('validAssignment')}</p></section>`}
function profile(){const w=W(S.active)||S.workers[0];return `${hero(t('profile'),t('settings'))}<section class="card" style="max-width:640px">${row(w)}<div class="section"><h2>${t('chooseWorker')}</h2></div><select id="workerProfile" class="select">${S.workers.map(x=>`<option value="${e(x.id)}" ${x.id===w.id?'selected':''}>${e(x.name)}</option>`).join('')}</select><div class="section"><h2>${t('preferredLanguage')}</h2></div><div class="seg" style="width:max-content"><button data-lang="en" class="${S.lang==='en'?'active':''}">${t('english')}</button><button data-lang="es" class="${S.lang==='es'?'active':''}">${t('spanish')}</button></div><p class="meta" style="margin-top:18px">${t('notProduction')}</p><button class="btn danger" data-action="reset">${t('clearData')}</button></section>`}
function coursePage(){const a=S.assignments.find(x=>x.id===S.courseId);if(!a){S.page='training';return training()}const c=courses[a.course],steps=['lesson1','lesson2','lesson3'];if((a.step||0)<3){return `${hero(t(c.title),`${t('lesson')} ${(a.step||0)+1}/3`)}<section class="card lesson"><span class="status pending">${t('lesson')} ${(a.step||0)+1}/3</span><h2>${t(steps[a.step||0])}</h2><p>${t('noticeBody')}</p><ul><li>${t('identity')}</li><li>${t('task')}</li><li>${t('notice')}</li></ul><div class="actions"><button class="btn" data-action="courseBack">${t('back')}</button><button class="btn primary" data-action="courseNext">${t('next')}</button></div></section>`}return quizPage(a,c)}
function quizPage(a,c){return `${hero(t('knowledge'),t(c.title))}<section class="card lesson"><h2>${t('knowledge')}</h2>${[['q1','a1','bad1'],['q2','a2','bad2'],['q3','a3','bad3']].map((q,i)=>`<div><p><strong>${i+1}. ${t(q[0])}</strong></p><label class="choice"><input type="radio" name="q${i}" value="ok">${t(q[1])}</label><label class="choice"><input type="radio" name="q${i}" value="bad">${t(q[2])}</label></div>`).join('')}<label class="label">${t('signature')}<input id="signature" class="input" value="${e(W(a.worker)?.name||'')}"></label><label class="choice"><input id="ack" type="checkbox">${t('ack')}</label><div class="actions"><button class="btn" data-action="courseBack">${t('back')}</button><button class="btn primary" data-action="submitCourse">${t('finish')}</button></div></section>`}
function assignModal(worker=''){const allowed=Object.entries(courses).filter(([,c])=>c.owner===S.role);modalBody.innerHTML=`<h2>${t('assignTraining')}</h2><div class="form"><label class="label">${t('chooseWorker')}<select id="assignWorker" class="select">${S.workers.map(w=>`<option value="${e(w.id)}" ${w.id===worker?'selected':''}>${e(w.name)}</option>`).join('')}</select></label><label class="label">${t('course')}<select id="assignCourse" class="select">${allowed.map(([id,c])=>`<option value="${id}">${t(c.title)}</option>`).join('')}</select></label><label class="label">${t('due')}<input id="assignDue" class="input" type="date" min="${new Date().toISOString().slice(0,10)}" value="2026-08-15"></label><label class="label">${t('language')}<select id="assignLang" class="select"><option value="preferred">${t('preferred')}</option><option value="en">${t('english')}</option><option value="es">${t('spanish')}</option></select></label><div class="actions"><button class="btn" data-action="close">${t('cancel')}</button><button class="btn primary" data-action="saveAssignment">${t('save')}</button></div></div>`;modal.hidden=false}
function render(){document.documentElement.lang=S.lang;let body;if(S.page==='course')body=coursePage();else if(S.role==='mine')body=S.page==='gate'?gate():S.page==='people'?people():S.page==='training'?training():mineToday();else if(S.role==='employer')body=S.page==='people'?people():S.page==='training'?training():S.page==='reports'?reports():employerToday();else body=S.page==='training'?training():S.page==='pass'?passPage():S.page==='profile'?profile():workerHome();app.innerHTML=`<div class="app">${header()}<main class="wrap">${nav()}${body}</main></div>`;syncUrl()}
